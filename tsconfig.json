{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    // `noUncheckedIndexedAccess` fica de fora de propósito: a declaração de
    // CSS Modules do Vite é uma index signature, então com ela ligada todo
    // `styles.algumaCoisa` viraria `string | undefined` e exigiria `!` em cada
    // className do projeto — ruído sem ganho real de segurança.

    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,

    // sem `baseUrl` (deprecado no TS 7): os paths resolvem relativos a este arquivo
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"]
}
